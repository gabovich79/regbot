GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-api-key
ADMIN_PASSWORD=your-admin-password
DEFAULT_MODEL=gemini-2.5-flash
MAX_TOKENS_WARNING=150000
CACHE_TTL_MINUTES=5
DATA_DIR=./data

# Evidence v2 public demo. Set real secrets via the deployment secret manager.
DEMO_SESSION_SECRET=
PUBLIC_BASE_URL=https://regbot-wly9.onrender.com
COOKIE_SECURE=1
TRUSTED_PROXY_IPS=
# No guessed rates: configure verified USD/1M rates for exact model names.
# Unknown pricing disables paid public requests. See docs/EVIDENCE_V2_RUNBOOK.md.
PROVIDER_PRICES_JSON={}
INDEX_DOCUMENT_BUDGET_USD=5
